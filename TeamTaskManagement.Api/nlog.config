<?xml version="1.0" encoding="utf-8" ?>
<!-- TeamTaskManagement.Api/nlog.config -->
<!-- throwConfigExceptions: שגיאה בקובץ הזה עוצרת את העלייה, במקום לוג שקט שלא נכתב -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<!-- תאריך | רמה | CorrelationId (מה-scope של CorrelationIdMiddleware) | מקור | הודעה | חריגה בשורה נפרדת -->
	<variable name="lineLayout"
			  value="${longdate}|${level:uppercase=true}|${scopeproperty:item=CorrelationId:whenEmpty=-}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

	<targets>
		<!-- קונסולה: זה מה ש-Render מציג -->
		<target xsi:type="Console" name="console" layout="${lineLayout}" />

		<!-- קובץ יומי בתיקיית הריצה, 14 קבצים אחרונים -->
		<target xsi:type="File" name="file"
				fileName="${basedir}/logs/app-${shortdate}.log"
				layout="${lineLayout}"
				encoding="utf-8"
				maxArchiveFiles="14" />
	</targets>

	<rules>
		<!-- הודעות עלייה וכיבוי של השרת (כתובת האזנה, סביבה) -->
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />
		<!-- רעש של ה-framework ו-EF Core (כולל כל פקודות ה-SQL): רק Warning ומעלה ממשיכים לכלל האחרון -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />
		<!-- הקוד שלנו: Info ומעלה -->
		<logger name="*" minlevel="Info" writeTo="console,file" />
	</rules>
</nlog>