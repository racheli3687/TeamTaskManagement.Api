<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a99e77eb-0ed8-439d-a21d-60b6ee0b7472</UserSecretsId>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <!-- 1591: אזהרה על public בלי ///. מתעדים רק את ה-Actions וה-Controllers, ולא constructors ו-Program -->
	  <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.32" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeamTaskManagement.Core\TeamTaskManagement.Core.csproj" />
    <ProjectReference Include="..\TeamTaskManagement.Service\TeamTaskManagement.Service.csproj" />
  </ItemGroup>

</Project>
